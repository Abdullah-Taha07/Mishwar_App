# Configure these as Vercel Environment Variables (Production + Preview as appropriate).
# Use a unique password of at least 16 characters; never commit real values.
ADMIN_LOGIN_PASSWORD=
# Generate a random secret of at least 32 characters. Keep it private.
ADMIN_SESSION_SECRET=
# Cloudflare Worker base URL, without a trailing slash.
HUB_URL=https://mishwar-api.abduuallah3.workers.dev
# Must exactly match the ADMIN_SERVICE_KEY secret on the Cloudflare Hub Worker.
ADMIN_SERVICE_KEY=
