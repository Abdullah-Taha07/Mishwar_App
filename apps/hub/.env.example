# Set server-side through Sites runtime configuration; never bundle in public assets.
CAPTAIN_ADMIN_EMAIL=

# Phone verification (Twilio Verify): configure all three to enable real SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Web Push server configuration; private JWK is a secret.
VAPID_PRIVATE_JWK=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# Dedicated HTTPS OSRM route service for production (default is the shared demo service).
OSRM_BASE_URL=
