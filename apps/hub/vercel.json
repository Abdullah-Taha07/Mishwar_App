{
    "rewrites":  [
                     {
                         "source":  "/api/:path*",
                         "destination":  "https://mishwar-api.abduuallah3.workers.dev/api/:path*"
                     },
                     {
                         "source":  "/dashboard",
                         "destination":  "/dashboard.html"
                     },
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ],
    "version":  2,
    "buildCommand":  "npm run build",
    "outputDirectory":  "public"
}
